[Unit]
Description=Server Status Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/sss/agent/
EnvironmentFile=/etc/sss-agent.env
ExecStart=/usr/bin/python3 /opt/sss/agent/client-linux.py
Restart=always
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
